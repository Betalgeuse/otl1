{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "otl1-onething-garden",
  "account_id": "1216831373fd0ae2b3e7c2b6641bee46",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "workers_dev": true,
  "vars": { "COMMUNITY_WELCOME_CHANNEL_ID": "C0C013CF223", "COMMUNITY_GUIDE_FILE_IDS": "F0C2S01GE06,F0C2P2G2DFF", "COMMUNITY_GUIDE_CHAPTER_CHANNEL_IDS": "C0C07S7MLJG,C0C07DD9RV0,C0C09AGKKPB", "COMMUNITY_INTRO_CHANNEL_ID": "C0C055JJA2J", "COMMUNITY_BOT_USER_ID": "U0C0ASC06BW", "DATABASE_MAINTENANCE": "false", "DAILY_SCRUM_CHANNEL_ID": "C0BVB9HSL10", "LLM_PILOT_CHANNEL_ID": "C0C0AMK8068", "LLM_PILOT_USER_ID": "U0BV52VENTD", "COMMUNITY_ENABLED": "true", "LIFECYCLE_MODE": "disabled", "REVIEW_THREAD_V2": "false", "GARDEN_RECONCILIATION": "false", "REFERRALS_ENABLED": "false", "PUBLIC_APPLICATIONS_ENABLED": "false", "PUBLIC_INTEREST_ENABLED": "false", "PUBLIC_APPLICATION_ORIGIN": "https://otl1.hyuk.me", "COMMUNITY_CHANNEL_ID": "C0C0AMK8068", "COMMUNITY_ADMIN_ID": "U0BV52VENTD", "COMMUNITY_RELEASE_CHANNEL_ID": "C0C0621V0QZ", "COMMUNITY_FEEDBACK_CHANNEL_ID": "C0BV6T22SH3", "COMMUNITY_PUBLIC_CHANNEL_ID": "C0BVB9HSL10" },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "COMMUNITY_CLOCK", "class_name": "CommunityClock" }] },
  "migrations": [{ "tag": "community-clock-v1", "new_sqlite_classes": ["CommunityClock"] }],
  "ratelimits": [{ "name": "INTENT_RATE_LIMITER", "namespace_id": "202609101", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUG_PRIVATE_OBJECTS", "bucket_name": "otl1-bug-private" }, { "binding": "INVITE_PRIVATE_OBJECTS", "bucket_name": "otl1-invite-private" }]
}
